EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=

# Real campaign calls also need these: the public (tunnel) URL Exotel posts call results to,
# and a random token that the status callback must carry.
PUBLIC_URL=
WEBHOOK_TOKEN=
DIAL_CONCURRENCY=2
CALL_WINDOW=09:00-20:00

# 1 = seed sample campaigns into an empty database and simulate calls (no real calls).
DEMO=0
REACHOUT_DB=reachout.db

# Script drafting (one call per campaign). Leave both empty to use the built-in templates.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m

# Recording playback stays off until a PIN is set. SESSION_SECRET keeps unlocks valid across restarts.
RECORDINGS_PIN=
SESSION_SECRET=

# Sign in with ChatGPT: drafting on the connected account's plan, with Ollama/Sarvam/templates as fallback.
# The sign-in redirects to http://127.0.0.1:CHATGPT_REDIRECT_PORT/auth/callback, so open the dashboard on the
# same machine as the backend. Commercial or hosted use needs OpenAI approval.
CHATGPT_AUTH_FILE=chatgpt_auth.json
CHATGPT_REDIRECT_PORT=8000
CHATGPT_MODEL=
FRONTEND_URL=http://localhost:3000

# ElevenLabs. Voice: each campaign's scripts and recipient names are synthesised once before calls
# start (cached in AUDIO_DIR). Per-language overrides: ELEVENLABS_VOICE_ID_HI, ELEVENLABS_MODEL_ML, etc.
# Default model: eleven_multilingual_v2 for en/hi/ta, eleven_v3 for the other Indian languages.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_CONCURRENCY=2
AUDIO_DIR=audio
# Agent for key 4 (Conversational AI). See backend/elevenlabs.py for the agent setup it expects.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_LANGUAGE_OVERRIDE=0
MENU_WAIT_SECONDS=8
