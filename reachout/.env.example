# Web phone: campaigns ring the page at /phone (see PHONE_TOKEN below). One call at a time, any hour.
# 1 = seed sample campaigns into an empty database and simulate calls (no real calls).
DEMO=0
REACHOUT_DB=reachout.db

# MongoDB instead of SQLite: set the connection string (Atlas or local) and optionally the database name.
# Copy an existing reachout.db across once with:  python -m backend.migrate_to_mongo
MONGODB_URI=mongodb+srv://abhishekp9a_db_user:EK0wblXY4TrnBBg7@reachout.xjau62l.mongodb.net
MONGODB_DB=reachout

# Providers: ElevenLabs and Gemini (keys below). Gemini writes the scripts and the agent prompt, and can hold a
# whole live call; with no key the built-in templates are used. SARVAM_API_KEY is used only for dictation.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Default provider for new campaigns is saved from the Providers page (settings.json).

# Web phone: open http://localhost:8000/phone and campaigns on "Web phone" ring it. Set a token before exposing
# the backend to the internet, then open /phone#token=<value>.
PHONE_TOKEN=

# Recording playback stays off until a PIN is set. SESSION_SECRET keeps unlocks valid across restarts.
# Web-phone calls are recorded (both sides, live agent or keypad IVR) and the audio is kept in the database.
# RECORD_CALLS=all (default) records every call; "campaign" only records campaigns whose record flag is on.
# RECORDINGS_SAVE=0 turns all recording off. Playback needs RECORDINGS_PIN below.
RECORD_CALLS=all
# After each recorded call, Gemini listens to the recording once and keeps every question asked and answer given
# (shown in History and on the campaign page). The audio goes to Google for this. Needs GEMINI_API_KEY; 0 = off.
CALL_ANALYSIS=1
# RECORDINGS_KEY encrypts it before it is stored; generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the key safe: audio saved with a key cannot be played without it.
RECORDINGS_SAVE=1
RECORDINGS_KEY=
RECORDINGS_PIN=
SESSION_SECRET=

FRONTEND_URL=http://localhost:3000

# Sign in with ChatGPT: scripts and the assistant chat use the connected account's ChatGPT plan first, then our
# own model. The sign-in returns to http://127.0.0.1:CHATGPT_REDIRECT_PORT/auth/callback, so open the dashboard on
# the machine that runs the backend. Hosted multi-user use needs OpenAI's approval.
CHATGPT_AUTH_FILE=chatgpt_auth.json
CHATGPT_REDIRECT_PORT=8000
CHATGPT_MODEL=

# ElevenLabs. Voice: each campaign's scripts and recipient names are synthesised once before calls
# start (cached in AUDIO_DIR). Per-language overrides: ELEVENLABS_VOICE_ID_HI, ELEVENLABS_MODEL_ML, etc.
# Default model: eleven_multilingual_v2 for en/hi/ta, eleven_v3 for the other Indian languages.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_CONCURRENCY=2
AUDIO_DIR=audio
# Agent that answers callers who ask something when the call ends with "any other questions?"
# (Conversational AI). See backend/elevenlabs.py for the agent setup it expects.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_LANGUAGE_OVERRIDE=0
MENU_WAIT_SECONDS=8
# Listening window after "any other questions?", the loudness that counts as speech (16-bit RMS),
# and the longest an agent conversation may run (cost cap).
DOUBT_WAIT_SECONDS=6
VAD_RMS=700
AGENT_MAX_SECONDS=300

# Voice input in the dashboard assistant for browsers without built-in speech recognition (Chrome and
# Edge need none of this). Uses SARVAM_API_KEY (India) first, then ELEVENLABS_API_KEY.
SARVAM_STT_MODEL=saarika:v2
ELEVENLABS_STT_MODEL=scribe_v1
